# IDE layout: nvim (top ~70%) + terminal (bottom ~30%)
# Usage: kitty --session ~/.config/kitty/ide.session --directory <project>
layout splits
# Run nvim through an interactive login shell so it inherits the full user env
# (brew, nvm/node, go) — GUI-launched kitty has a bare PATH otherwise
launch zsh -il -c nvim
focus
# --dont-take-focus: without it, launching this pane steals focus back from
# nvim above, so the first keys typed (e.g. <space>ff) go to the shell instead
launch --location=hsplit --bias=30 --dont-take-focus
